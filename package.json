{
  "name": "protokits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5178 --mode protokits",
    "dev:snorlaxgarage": "vite --host --port 5173 --mode snorlaxgarage",
    "dev:liquikits": "vite --host --port 5174 --mode liquikits",
    "dev:protokits": "vite --host --port 5178 --mode protokits",
    "dev:komiprints": "vite --host --port 5175 --mode komiprints",
    "dev:garagecore": "vite --host --port 5176 --mode garagecore",
    "dev:daivevargas": "vite --host --port 5177 --mode daivevargas",
    "dev:all": "concurrently \"npm run dev:snorlaxgarage\" \"npm run dev:liquikits\" \"npm run dev:protokits\" \"npm run dev:komiprints\" \"npm run dev:garagecore\" \"npm run dev:daivevargas\"",
    "build": "vite build --mode protokits",
    "build:liquikits": "vite build --mode liquikits",
    "lint": "eslint .",
    "preview": "vite preview",
    "garage": "concurrently \"npm run dev\""
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^12.35.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  }
}
