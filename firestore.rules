rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsOrder() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsHunt() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- PUBLIC COLLECTIONS ---
    match /settings/garage {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/checkout {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /methods/{id} {
      allow read: if true;
    }

    match /printers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feeders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /extras/{id} {
      allow read: if true;
    }

    match /rates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /filaments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- KITS ---
    match /kits/{kitId} {
      allow read: if true;
      // Guest checkout reserves stock through a verified server transaction.
      // This prevents anonymous visitors from changing stock directly.
      allow write: if signedIn() && !isAnonymous(); // Existing non-guest path remains pending server migration.
    }

    // --- BLUEPRINTS ---
    match /blueprints/{blueprintId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- DEALS ---
    match /deals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- HUNTS / OFFERS ---
    match /hunts/{huntId} {
      allow get, list: if isAdmin() || ownsHunt();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        ownsHunt()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.kitId == resource.data.kitId
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'targetPrice', 'status', 'expiresAt', 'updatedAt', 'declinedAt', 'declinedBy'
        ])
      );
      allow delete: if isAdmin() || ownsHunt();
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isOwner(userId);

      match /basket/{basketId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // New market-specific baskets used by LIQUIKITS and KOMIPRINTS.
      // The legacy /basket collection above remains unchanged for
      // SnorlaxGarage compatibility and GARAGECORE's admin shelf workflows.
      match /baskets/{market}/{basketId} {
        allow read: if market in ['liquikits', 'komiprints'] && (isOwner(userId) || isAdmin());
        allow write: if market in ['liquikits', 'komiprints'] && isOwner(userId);
      }
    }

    // --- PROJECT VAULTS ---
    match /projectVaults/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admin rate changes reprice saved estimates across all vaults.
      allow write: if isOwner(uid) || isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow get, list: if isAdmin() || ownsOrder();
      // Guest orders are created only by the verified Vercel endpoint.
      allow create: if signedIn() && !isAnonymous() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        ownsOrder()
        && request.resource.data.userId == resource.data.userId
        && (!('receipt' in resource.data) || resource.data.receipt == null || resource.data.receipt == "")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'receipt', 'balanceReceipt', 'cancellationTimerStartedAt', 'cancelledAt', 'lastUpdated'
        ])
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status == 'Validating'
          || request.resource.data.status == 'Cancelled'
        )
      );
    }

    // --- ADMINS ---
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      // Admin documents are role grants. Never let a user create their own.
      // Bootstrap the first admin manually in the Firebase console, then manage
      // future admins from an authenticated admin session or trusted backend.
      allow create, update, delete: if isAdmin();
    }

  }
}
