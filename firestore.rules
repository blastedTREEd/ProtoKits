rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsOrder() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsHunt() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isValidAppVisibility() {
      return request.resource.data.keys().hasOnly(['visibility', 'updatedAt'])
        && request.resource.data.visibility is map
        && request.resource.data.visibility.keys().hasOnly([
          'snorlaxgarage', 'liquikits', 'protokits', 'komiprints', 'garagecore'
        ])
        && (!('snorlaxgarage' in request.resource.data.visibility) || request.resource.data.visibility.snorlaxgarage is bool)
        && (!('liquikits' in request.resource.data.visibility) || request.resource.data.visibility.liquikits is bool)
        && (!('protokits' in request.resource.data.visibility) || request.resource.data.visibility.protokits is bool)
        && (!('komiprints' in request.resource.data.visibility) || request.resource.data.visibility.komiprints is bool)
        && (!('garagecore' in request.resource.data.visibility) || request.resource.data.visibility.garagecore is bool)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function validUserProfileCreate(userId) {
      return request.resource.data.uid == userId
        && (!('role' in request.resource.data)
          || request.resource.data.role in ['customer', 'guest']);
    }

    function validUserProfileUpdate() {
      return request.resource.data.uid == resource.data.uid
        && (!('role' in resource.data)
          || request.resource.data.role == resource.data.role);
    }

    function validVaultWrite(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
    }

    function validHuntCreate() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kitId is string
        && request.resource.data.kitId.size() <= 200
        && request.resource.data.targetPrice is number
        && request.resource.data.targetPrice >= 0
        && request.resource.data.targetPrice <= 100000000
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAt.size() <= 64;
    }

    function validHuntUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.kitId == resource.data.kitId
        && request.resource.data.targetPrice is number
        && request.resource.data.targetPrice >= 0
        && request.resource.data.targetPrice <= 100000000
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAt.size() <= 64;
    }

    // --- PUBLIC COLLECTIONS ---
    match /settings/garage {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/checkout {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/apps {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAppVisibility();
      allow delete: if isAdmin();
    }

    match /methods/{id} {
      allow read: if true;
    }

    match /printers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feeders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /extras/{id} {
      allow read: if true;
    }

    match /rates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /filaments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- KITS ---
    match /kits/{kitId} {
      allow read: if true;
      // Guest checkout reserves stock through a verified server transaction.
      // This prevents anonymous visitors from changing stock directly.
      allow write: if signedIn() && !isAnonymous(); // Existing non-guest path remains pending server migration.
    }

    // --- BLUEPRINTS ---
    match /blueprints/{blueprintId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- DEALS ---
    match /deals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- HUNTS / OFFERS ---
    match /hunts/{huntId} {
      allow get, list: if isAdmin() || ownsHunt();
      allow create: if signedIn() && validHuntCreate();
      allow update: if isAdmin() || (
        ownsHunt()
        && validHuntUpdate()
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'targetPrice', 'status', 'expiresAt', 'updatedAt', 'declinedAt', 'declinedBy'
        ])
      );
      allow delete: if isAdmin() || ownsHunt();
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && validUserProfileCreate(userId));
      allow update: if isAdmin() || (isOwner(userId) && validUserProfileUpdate());
      allow delete: if isAdmin();

      match /basket/{basketId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      // New market-specific baskets used by LIQUIKITS and KOMIPRINTS.
      // The legacy /basket collection above remains unchanged for
      // SnorlaxGarage compatibility and GARAGECORE's admin shelf workflows.
      match /baskets/{market}/items/{basketId} {
        allow read: if market in ['liquikits', 'komiprints'] && (isOwner(userId) || isAdmin());
        allow write: if market in ['liquikits', 'komiprints'] && isOwner(userId);
      }
    }

    // --- PROJECT VAULTS ---
    match /projectVaults/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admin rate changes reprice saved estimates across all vaults.
      allow create, update: if isAdmin() || (isOwner(uid) && validVaultWrite(uid));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      allow get, list: if isAdmin() || ownsOrder();
      // Guest orders are created only by the verified Vercel endpoint.
      allow create: if signedIn() && !isAnonymous() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        ownsOrder()
        && request.resource.data.userId == resource.data.userId
        && (!('receipt' in resource.data) || resource.data.receipt == null || resource.data.receipt == "")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'receipt', 'balanceReceipt', 'cancellationTimerStartedAt', 'cancelledAt', 'lastUpdated'
        ])
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status == 'Validating'
          || request.resource.data.status == 'Cancelled'
        )
      );
    }

    // --- ADMINS ---
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      // Admin documents are role grants. Never let a user create their own.
      // Bootstrap the first admin manually in the Firebase console, then manage
      // future admins from an authenticated admin session or trusted backend.
      allow create, update, delete: if isAdmin();
    }

  }
}
