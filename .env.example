# Public browser configuration (safe to expose)
VITE_APP_ID=liquikits
# Keep these values pointed at the intended shared Firebase project for local
# testing. The current source falls back to the production SnorlaxGarage web
# configuration when they are omitted.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=snorlaxgarage
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
